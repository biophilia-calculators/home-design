{
  "$schema": "node_modules/wrangler/config-schema.json",
"name": "home-design",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",

  // Top-level / default configuration (deployed when running: npx wrangler deploy)
  "vars": {
    "ENVIRONMENT": "production"
  },

  // Named environment overrides
  "env": {
    // Deployed when running: npx wrangler deploy --env staging
    "staging": {
      "name": "my-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },

    // Deployed when running: npx wrangler deploy --env production
    "production": {
      "name": "my-worker-production",
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
